# Copy this to .env and fill in real values. Never commit .env.
ANTHROPIC_API_KEY=sk-ant-...

# Week 6 embeddings: Gemini by default (same key OpenClaw uses, copy it from ~/.openclaw/.env)
GEMINI_API_KEY=
# or OpenAI instead: set EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=sk-...
EMBEDDING_PROVIDER=gemini
EMBEDDING_DIMS=768

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=idx_user
MYSQL_PASSWORD=your_secure_password
MYSQL_DATABASE=idx_exchange

# Week 4: how long a search session is remembered (minutes)
SESSION_TTL_MINUTES=120

# Gmail: use an App Password (Google Account > Security > App passwords), not your real password
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
